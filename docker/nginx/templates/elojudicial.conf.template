upstream elojudicial_web {
    zone elojudicial_web 64k;
    server web:8000 resolve;
}

# Porta 80: apenas validação ACME (Let's Encrypt) e redirecionamento para HTTPS.
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS do sistema. Não escuta porta: recebe da 443 (bloco stream) via socket local,
# com PROXY protocol para manter o IP real do cliente.
server {
    listen unix:/run/nginx/https.sock ssl proxy_protocol default_server;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    set_real_ip_from unix:;
    real_ip_header proxy_protocol;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    client_max_body_size 20m;

    location / {
        # Se o usuário sair da página no meio de uma consulta ao tribunal, o sistema
        # termina e grava a resposta mesmo assim (ex.: avisos pendentes, entregues uma única vez).
        proxy_ignore_client_abort on;
        proxy_pass http://elojudicial_web;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
