# Copie para .env e ajuste os valores.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,www.elojudicial.com.br/
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
POSTGRES_DB=elojudicial
POSTGRES_USER=elojudicial
POSTGRES_PASSWORD=troque-esta-senha

# Senha do Redis (sem caracteres especiais de URL: @ : / ?).
REDIS_PASSWORD=troque-esta-senha

# nginx: único serviço exposto (portas 80 e 443).
# Nome do sistema e nomes TLS (SNI) que levam ao Postgres e ao Redis pela porta 443.
NGINX_SERVER_NAME=localhost
NGINX_DB_HOST=db.localhost
NGINX_REDIS_HOST=redis.localhost
# IPs/redes que podem acessar o banco e o Redis (separados por vírgula). Vazio = ninguém.
NGINX_SERVICOS_PERMITIDOS=
# Pasta com fullchain.pem e privkey.pem. Sem eles, é gerado um certificado autoassinado.
NGINX_CERTS_DIR=./docker/nginx/certs

# E-mail (SMTP de produção). Sem EMAIL_HOST, os e-mails vão para o console.
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=EloJudicial <nao-responda@exemplo.com>


# Tempo (segundos) em que o hash da senha do sistema judicial fica em cache (padrão: 2 horas).
MNI_SENHA_TTL=7200
