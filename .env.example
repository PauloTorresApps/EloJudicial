# Copie para .env e ajuste os valores.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=elojudicial
POSTGRES_USER=elojudicial
POSTGRES_PASSWORD=troque-esta-senha

WEB_PORT=8000

# E-mail (SMTP de produção). Sem EMAIL_HOST, os e-mails vão para o console.
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=EloJudicial <nao-responda@exemplo.com>


# Tempo (segundos) em que o hash da senha do sistema judicial fica em cache (padrão: 2 horas).
MNI_SENHA_TTL=7200
